  "rules": "Driving decision rules for this experiment:\n1. STOP for a pedestrian or obstacle in the planned path, an outstanding required\n   stop, or a known prohibition on the proposed maneuver (for example, red).\n2. For a left turn, STOP for conflicting traffic from the left, right, or opposite\n   direction. For straight travel, STOP for crossing traffic from left or right.\n   For a right turn, STOP for conflicting traffic from the left.\n3. If none of those stopping conditions is established, REQUEST_INFO when\n   traffic-control permission is unknown, required sensor coverage is unavailable,\n   or sensor reports conflict. Keep the vehicle stopped while gathering information.\n4. Otherwise PROCEED with the specified maneuver.\nA confirmed stopping condition takes priority over missing/conflicting information.\nThese are the experiment's explicit traffic rules, not a complete driving rulebook.",
  "specifications": {
    "pedestrian_no_proceed": [
      "G (pedestrian_in_path -> action != proceed)",
      "Wait for pedestrians in the intended path."
    ],
    "obstacle_no_proceed": [
      "G (obstacle_in_path -> action != proceed)",
      "Do not enter a blocked path."
    ],
    "traffic_no_proceed": [
      "G (traffic_conflict -> action != proceed)",
      "Yield to traffic that conflicts with the proposed maneuver."
    ],
    "required_stop": [
      "G (stop_required -> action != proceed)",
      "Complete the required stop before proceeding."
    ],
    "permission_required": [
      "G ((permission_known & !movement_permitted) -> action != proceed)",
      "Do not perform a maneuver prohibited by the known traffic control."
    ],
    "unknown_permission": [
      "G (!permission_known -> action != proceed)",
      "Establish traffic-control permission before moving."
    ],
    "sensor_coverage": [
      "G (!sensor_data_available -> action != proceed)",
      "Missing required observations do not establish a clear route."
    ],
    "conflicting_sensors": [
      "G (sensor_conflict -> action != proceed)",
      "Resolve inconsistent sensor data before moving."
    ],
    "blocked_stop": [
      "G (blocked -> action = stop)",
      "A confirmed hazard or mandatory stop takes priority over uncertainty."
    ],
    "uncertainty_request": [
      "G ((!blocked & uncertain) -> action = request_info)",
      "Remain stopped and request information when safety or permission is uncertain."
    ],
    "clear_proceed": [
      "G ((!blocked & !uncertain) -> action = proceed)",
      "Proceed with the permitted maneuver when all required conditions establish clearance."
